# ============================================================================
#  Database — Turso / libSQL
#  Copy this file to .env.local and adjust. .env.local is gitignored.
#  Anything left unset falls back to the defaults in src/config/database.mjs.
# ============================================================================

# Which database to talk to: local | turso | embedded
#   local     → a file on disk (no network, no token needed)   [current setup]
#   turso     → Turso cloud over the network
#   embedded  → local file kept in sync with Turso in the background
DB_MODE=local

# --- local mode -------------------------------------------------------------
# Path is relative to the project root.
LOCAL_DB_FILE=data/tracking.db

# --- turso / embedded mode (fill in when you move to the cloud) --------------
# turso db show <db-name> --url
TURSO_DATABASE_URL=
# turso db tokens create <db-name>
TURSO_AUTH_TOKEN=

# embedded mode only: local replica file + how often to sync (seconds)
EMBEDDED_DB_FILE=data/replica.db
TURSO_SYNC_INTERVAL=60
